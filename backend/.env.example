# AetherLog backend - example configuration
# Copy to backend/.env and fill in your own values. This file contains NO secrets: every secret is left empty.
# Lists every setting the backend reads (process.env.*). Values shown are the safe defaults used by the code.

# --- Server ------------------------------------------------------------------------------------------------
PORT=4000
# URL of the web frontend (used for CORS and links in e-mails)
FRONTEND_URL=http://localhost:3000
# REQUIRED (at least 32 characters; the backend refuses to start without it): a long random secret for signing
# login tokens. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Database (PostgreSQL / TimescaleDB) ---------------------------------------------------------------------
# Either DATABASE_URL (cloud databases, uses TLS) ...
DATABASE_URL=
# ... or the individual settings below (local docker-compose database: port 5435).
# POSTGRES_PASSWORD is REQUIRED when DATABASE_URL is empty (no built-in default; the backend refuses to start).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=ailoganalyzer

# --- AI service (python-service) -----------------------------------------------------------------------------
# Use 127.0.0.1, not localhost: on Windows "localhost" first tries IPv6 and adds ~2 s per call.
PYTHON_SERVICE_URL=http://127.0.0.1:5001
# Shared secret between the backend and the AI service. Put the SAME value in python-service/.env (and in the .env
# next to docker-compose.yml for Docker). The AI service accepts requests from this computer, or with this key.
AI_SERVICE_KEY=
# Anomaly scoring model: "cascade" = BGL cascade (TF-IDF + LR gate -> DistilBERT, trained on BGL logs only);
# anything else / empty = keyword rule.
ANOMALY_MODEL=keyword
# With ANOMALY_MODEL=cascade, alerts come ONLY from the cascade decision (anomaly = true), not from the log level.
# To also alert on log levels, create an explicit level rule, e.g. ALERT_LEVEL_RULE=FATAL (or FATAL,ERROR).
# Empty = no level rule. (Without cascade, the keyword rule alerts on FATAL or score >= threshold, as before.)
ALERT_LEVEL_RULE=

# --- Log ingestion (/api/ingest) -----------------------------------------------------------------------------
# Requests per second per API key (a batch counts as one request). /api/ingest is excluded from the general
# /api limit (1,000 requests per 15 minutes per IP).
INGEST_RATE_LIMIT_PER_SECOND=100
# Maximum logs per batch request (413 above)
INGEST_MAX_BATCH=500
# Maximum logs per second per API key, over all requests (429 above)
INGEST_LOGS_PER_SECOND=5000
# Cache of successful API-key checks, in seconds (0 = off). Revoked keys are rejected on their next request.
API_KEY_CACHE_TTL_SECONDS=300

# --- Demo data and testing -----------------------------------------------------------------------------------
# Synthetic demo logs are OFF unless this is set to exactly "false" (missing/empty/other = off).
DISABLE_DEMO_LOGS=true
# true = block EVERY outgoing notification (e-mail, SMS, webhook, Slack, Teams, Telegram). Required for tests;
# the test scripts refuse to run unless the backend reports testMode: true. Keep false in normal use.
TEST_MODE=false

# --- Log retention -------------------------------------------------------------------------------------------
LOG_RETENTION_DAYS=30
LOG_CLEANUP_INTERVAL_HOURS=24

# --- Background queues ---------------------------------------------------------------------------------------
ALERT_QUEUE_CONCURRENCY=2
RUNBOOK_QUEUE_CONCURRENCY=2

# --- E-mail (SMTP / SendGrid / Resend) - leave empty to disable e-mail ---------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
SMTP_TIMEOUT_MS=10000
SMTP_RETRY_ATTEMPTS=2

# --- Webhooks (Slack / Teams / custom) -----------------------------------------------------------------------
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_RETRY_ATTEMPTS=2

# --- SMS (Twilio) - leave empty to disable SMS ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Telegram FATAL alerts - leave empty to disable ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI providers (optional) ---------------------------------------------------------------------------------
# Google Gemini key
API_KEY=
OPENAI_API_KEY=

# --- Payments (Stripe) - leave empty for simulated payments ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
